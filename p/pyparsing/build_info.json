{
  "maintainer": "Build Scripts Team",
  "package_name": "pyparsing",
  "language": "python",
  "github_url": "https://github.com/pyparsing/pyparsing",
  "version": "3.2.3",
  "wheel_build": true,
  "v2-enabled": true,
  "resource_class": "medium",
  "package_dir": "p/pyparsing",
  "default_branch": "master",
  "build_script": "pyparsing.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "*": {
    "build_script": "pyparsing.sh"
  }
}
