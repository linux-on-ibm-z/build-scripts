{
  "maintainer": "Build Scripts Team",
  "package_name": "iniconfig",
  "language": "python",
  "github_url": "https://github.com/pytest-dev/iniconfig",
  "version": "2.1.0",
  "wheel_build": true,
  "v2-enabled": true,
  "resource_class": "medium",
  "package_dir": "i/iniconfig",
